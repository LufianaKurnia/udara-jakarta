# Salin file ini menjadi .env lalu sesuaikan. JANGAN commit file .env

# ---- DBMS 1: PostgreSQL (Postgres.app) ----
PG_HOST=localhost
PG_PORT=5432
# Default Postgres.app: user = username macOS kamu (cek dengan perintah: whoami), tanpa password
PG_USER=GANTI_DENGAN_USERNAME_MAC
PG_PASSWORD=
PG_DATABASE=ispu_jakarta

# ---- DBMS 2: MySQL (XAMPP) ----
# Pakai 127.0.0.1 (bukan "localhost") agar koneksi lewat TCP, bukan unix socket
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
# Default XAMPP: user root, password kosong
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=ispu_master

# ---- Opsional (untuk nanti saat deploy ke cloud DB) ----
# POSTGRES_URL=postgresql://user:pass@host/dbname?sslmode=require
# MYSQL_URL=mysql+mysqlconnector://user:pass@host:3306/dbname
# MYSQL_DRIVER=mysqlconnector   # alternatif: pymysql (pip install pymysql)
